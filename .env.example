# Photographed / scanned butterfly. Drop the file at public/models/butterfly.glb
# or point this at another public URL. While absent, the painted study specimen shows.
VITE_BUTTERFLY_MODEL=/models/butterfly.glb

# "auto" stands flight-pose models (wings in XZ, head +Z) upright, dorsal side to camera.
# Otherwise give radians: x,y,z
VITE_BUTTERFLY_ROTATION=auto
VITE_BUTTERFLY_SCALE=1
# Embedded wing clips are slowed to a resting rhythm.
VITE_BUTTERFLY_ANIM_SPEED=0.35
